**/detekt-baseline.xml
**/lint-baseline.xml
**/*.hprof

# ---------------------------------------------------------------------------
# Kotlin/Native, KSP
# ---------------------------------------------------------------------------
.kotlin/

# Play upload key must never live in the repo (architecture.md §12.3) — CI
# injects it from KMS/secrets, never from a file here.
