<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false, but these rules also govern device-to-device transfer.
  Secrets live in no_backup/ and are Keystore-sealed, so they are unusable off-device
  regardless; excluding them explicitly is defence in depth (QA-8).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="modules" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="modules" />
    </device-transfer>
</data-extraction-rules>
