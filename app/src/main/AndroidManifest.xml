<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested contextually by NotificationService, never at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+), architecture.md §8.3.
      The <intent> form means a newly published satellite becomes discoverable
      without a Shell release. QUERY_ALL_PACKAGES is deliberately NOT used: it is a
      sensitive permission requiring a Play declaration and is unnecessary here.
    -->
    <queries>
        <intent>
            <action android:name="com.omnideck.action.FEDERATE" />
        </intent>
    </queries>

    <application
        android:name=".OmniDeckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniDeck"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.OmniDeck.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Every module route is reachable as a deep link through one entry point.

              No autoVerify here: verification only ever considers filters carrying
              http/https data, so the attribute is inert on a custom scheme and would
              read as though this filter were part of OD-321's flip.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="omnideck" />
            </intent-filter>

            <!--
              No https App Link filter here, deliberately — OmniDeck does not own a web
              origin yet (OD-716).

              One was declared for omnideck.app and is withdrawn. That domain is
              registered to someone else, so even with autoVerify="false" the filter had
              live effect: OmniDeck offered itself in the disambiguation chooser for a
              third party's URLs. Harmless while that host serves nothing, wrong the day
              it does, and not the kind of thing anyone notices in a diff later.

              Restoring it is three lines, and everything downstream is already built and
              tested: ExternalRoutes.fromWeb, the reserved /go/ prefix (ADR-011,
              architecture.md §10.1) and scripts/assetlinks.py. What is missing is only
              the origin.

                  <intent-filter android:autoVerify="false">
                      <action android:name="android.intent.action.VIEW" />
                      <category android:name="android.intent.category.DEFAULT" />
                      <category android:name="android.intent.category.BROWSABLE" />
                      <data
                          android:scheme="https"
                          android:host="<the origin we control>"
                          android:pathPrefix="/go/" />
                  </intent-filter>

              Do not restore it against a throwaway host. A shared link is permanent: once
              a URL under that origin is in someone's inbox, moving to a real domain
              breaks it unless the old origin serves redirects forever (ADR-011, accepted
              debt). Custom-scheme deep links above cost nothing and need no domain, which
              is why deferring this costs no functionality — only link shareability.
            -->
        </activity>

        <!-- WorkManager is initialised on demand by the kernel, not at process start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
