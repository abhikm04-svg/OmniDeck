<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested contextually by NotificationService, never at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+), architecture.md §8.3.
      The <intent> form means a newly published satellite becomes discoverable
      without a Shell release. QUERY_ALL_PACKAGES is deliberately NOT used: it is a
      sensitive permission requiring a Play declaration and is unnecessary here.
    -->
    <queries>
        <intent>
            <action android:name="com.omnideck.action.FEDERATE" />
        </intent>
    </queries>

    <application
        android:name=".OmniDeckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniDeck"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.OmniDeck.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Every module route is reachable as a deep link through one entry point.

              No autoVerify here: verification only ever considers filters carrying
              http/https data, so the attribute is inert on a custom scheme and would
              read as though this filter were part of OD-321's flip.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="omnideck" />
            </intent-filter>

            <!--
              App Links (OD-204). Under the reserved /go/ prefix the web path maps
              one-to-one onto the app's URI space (see ExternalRoutes), so a link
              shared from a browser and a link shared from the app are the same link.

              The prefix is what keeps the claim to the domain narrow. A filter on the
              bare host claims every URL on omnideck.app, including the public account
              deletion page that Play requires to stay reachable in a browser
              (architecture.md §19.2, omnideck.app/delete-account) — and once OD-321
              turns verification on, "claims" means the browser stops being offered at
              all. Per-module prefixes are not the alternative: naming a module in this
              file would fail ShellIsolationFitnessTest and end G1.

              autoVerify stays false until assetlinks.json is published at the domain
              (OD-321, carried from OD-204 into Phase 3). Turning it on without the
              file makes Android fail verification on every install and silently stop
              offering the app at all — worse than the disambiguation chooser we get
              now.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="omnideck.app"
                    android:pathPrefix="/go/" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialised on demand by the kernel, not at process start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
